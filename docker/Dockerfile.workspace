# syntax=docker/dockerfile:1

# The workspace image is the bot runtime base. The Server only supplies the
# bridge binary; base tools (node, python, uv), display dependencies, and
# runtime scripts are immutable image content. Agent CLIs are not part of the
# image: the workspace dependency manager installs them into /data per bot.
# Upgrade and rollback ordering: docs/workspace-dependencies-upgrade.md.

FROM rust:1.90-alpine AS a11y-cli-builder
RUN apk add --no-cache musl-dev
WORKDIR /work
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/work/target \
    set -eux; \
    cargo build --release -p a11y-cli; \
    cp target/release/a11y-cli /out-a11y-cli

FROM debian:bookworm-slim AS toolkit-builder
ARG TARGETARCH
RUN apt-get update \
  && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    binutils \
    ca-certificates \
    wget \
    xz-utils \
  && rm -rf /var/lib/apt/lists/*
COPY docker/toolkit/install.sh docker/toolkit/install-wrappers.sh /tmp/ami-toolkit/
COPY docker/toolkit/bin /tmp/ami-toolkit/bin
RUN AMI_TOOLKIT_GLIBC_ONLY=1 \
    AMI_TOOLKIT_SKIP_DISPLAY=1 \
    /tmp/ami-toolkit/install.sh /opt/ami/toolkit "${TARGETARCH:-amd64}"
COPY --from=a11y-cli-builder /out-a11y-cli /opt/ami/toolkit/display/bin/a11y-cli
RUN chmod 0755 /opt/ami/toolkit/display/bin/a11y-cli

# Only the live ACP integration-test target needs a bridge baked into the
# image. Production workspace containers receive the current bridge from the
# Server as a read-only file mount.
FROM --platform=$BUILDPLATFORM golang:1.26.10-alpine AS bridge-builder
ARG TARGETARCH
WORKDIR /build
RUN apk add --no-cache git
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH:-amd64} \
    go build -trimpath -ldflags "-s -w" -o /out/bridge ./cmd/bridge

FROM debian:bookworm-slim AS workspace
ARG AMI_APT_COMMAND_TIMEOUT=1200
ENV DEBIAN_FRONTEND=noninteractive \
    AMI_APT_COMMAND_TIMEOUT=${AMI_APT_COMMAND_TIMEOUT} \
    AMI_TOOLKIT_DIR=/opt/ami/toolkit \
    PATH=/opt/ami/toolkit/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WORKDIR /data

COPY scripts/desktop-install.sh /tmp/ami-desktop-install.sh
RUN set -eux; \
    progress() { :; }; \
    has_cmd() { command -v "$1" >/dev/null 2>&1; }; \
    find_browser() { \
      for candidate in google-chrome-stable google-chrome chromium chromium-browser; do \
        if has_cmd "$candidate"; then \
          command -v "$candidate"; \
          return 0; \
        fi; \
      done; \
      return 1; \
    }; \
    . /tmp/ami-desktop-install.sh; \
    export AMI_DISPLAY_INSTALL_ASSETS_GLOBAL=1; \
    install_debian; \
    apt_get install -y --no-install-recommends util-linux; \
    rm -rf /var/lib/apt/lists/* /root/.cache/ami-display-themes /tmp/ami-desktop-install.sh; \
    mkdir -p /data /tmp/.X11-unix /opt/ami/scripts; \
    chmod 0755 /data; \
    chmod 1777 /tmp/.X11-unix

COPY --from=toolkit-builder /opt/ami/toolkit /opt/ami/toolkit
COPY scripts/desktop-style.sh scripts/display-apply-style.sh scripts/display-prepare.sh /opt/ami/scripts/
RUN printf '%s\n' 'export PATH="/opt/ami/toolkit/bin:$PATH"' > /etc/profile.d/ami-toolkit.sh \
  && chmod 0755 /opt/ami/scripts/*.sh \
  && test -x /usr/bin/tini \
  && flock -n -E 75 /tmp/ami-workspace-lock-check true \
  && rm -f /tmp/ami-workspace-lock-check \
  && test -x /opt/ami/toolkit/bin/node \
  && test -x /opt/ami/toolkit/bin/python3 \
  && test -x /opt/ami/toolkit/bin/uv \
  && test -x /opt/ami/toolkit/display/bin/a11y-cli \
  && /bin/bash -lc 'node --version >/dev/null && npm --version >/dev/null'

# Standalone bridge-over-TCP image used only by live ACP tests.
FROM workspace AS toolkit-acp-bridge-live
COPY --from=bridge-builder /out/bridge /usr/local/bin/bridge
ENV BRIDGE_TCP_ADDR=:1455
EXPOSE 1455
ENTRYPOINT ["/usr/bin/tini", "-g", "--", "/usr/local/bin/bridge"]

# Keep the default build output equal to the production workspace target.
FROM workspace AS final
